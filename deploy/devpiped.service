[Unit]
Description=Devpipe terminal daemon
Documentation=https://github.com/wess/devpipe
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/devpiped
EnvironmentFile=/etc/devpipe/env
WorkingDirectory=/var/lib/devpipe

# The certificate and its key. StateDirectory gives us /var/lib/devpipe with
# the right ownership without a tmpfiles rule.
StateDirectory=devpipe
StateDirectoryMode=0750

Restart=always
RestartSec=2

# Sessions are children of this process, so the default control-group kill
# takes every one of them down with a restart. That is honest about what the
# daemon currently is: it survives a *client* disconnecting, not its own
# restart. Making sessions outlive an upgrade means moving the ptys out of
# this process, and is not something a KillMode setting can fake — leaving the
# group alive would just orphan them with nothing reading their output.
KillMode=control-group

# The daemon hands out shells, so most sandboxing options are pointless here —
# whatever we forbid, the shell would be forbidden too. These are the ones
# that still mean something: the daemon's own files stay off-limits to the
# sessions' reach through the filesystem it does not need.
NoNewPrivileges=no
ProtectHome=no
PrivateTmp=no

[Install]
WantedBy=multi-user.target
