# A user unit, not a system one.
#
# The tenancy Devpipe assumes is one person per host, and that person's
# environments should be owned by them: their ~/.devpipe, their workspaces,
# their ssh login, their docker group membership. A system unit would have to
# choose a user anyway, and would put the state somewhere that answering
# `ssh box cat ~/.devpipe/token` no longer works.
#
#   install -Dm644 deploy/devpipe.service ~/.config/systemd/user/devpipe.service
#   loginctl enable-linger "$USER"        # or it stops when you log out
#   systemctl --user enable --now devpipe
[Unit]
Description=Devpipe host

[Service]
# Loopback on purpose. Reaching this from anywhere else is `devpipe --ssh`,
# which means the only thing listening on a public interface is sshd — already
# hardened, already audited, already trusted with more than this.
ExecStart=/usr/local/bin/devpipe serve --bind 127.0.0.1:7455
Restart=always
RestartSec=2

# The whole point of keepers, and it does not work without this line.
#
# Sessions are separate processes so a restart of the daemon leaves them
# running. But systemd's default KillMode=control-group signals every process
# in the unit's cgroup, and a keeper is in it — being in its own *process*
# group, which is what the daemon arranges, is a different thing entirely and
# does not help. So a restart killed every session on the host, which is
# exactly what keepers exist to prevent.
#
# KillMode=process signals only the daemon. It is what sshd does, for this
# reason: a service restart should not log everybody out. The cost is that
# systemd stops reaping strays, which here is the behaviour being asked for.
KillMode=process

# Long enough for the pty threads to flush what they were painting.
TimeoutStopSec=10

[Install]
WantedBy=default.target
