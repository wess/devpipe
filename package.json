{
  "name": "devpipe",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/dev.ts",
    "api": "bun --hot src/server.ts",
    "web": "bun --hot src/web/serve.ts",
    "test": "bun test --concurrency=1 tests/",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format src/",
    "check": "biome check src/",
    "tidy": "biome check --write src/",
    "sweep": "bun scripts/sweep.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "dependencies": {
    "atlas": "github:wess/atlas#d830f3d1fed2b14fb3da9b3c811986f9d1773c9a",
    "lucide-react": "^0.468.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
