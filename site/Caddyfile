# devpipe.com — the lander, and nothing else yet.
#
# Certificates are issued automatically over HTTP-01, so every box uses the
# ordinary browser and operating-system trust path with no TLS exceptions.

{
	email wess@devpipe.com

	# Previews get a certificate the moment somebody asks for one, rather than
	# a wildcard nobody can issue. See the block at the bottom of this file.
	#
	# The `ask` is not optional and not a nicety: without it, anyone who points
	# a hostname at this address makes this server fetch a certificate on their
	# behalf, and enough of those gets the account rate-limited by Let's Encrypt
	# for names it has never heard of. The API answers 200 only for a preview
	# that exists and has not been revoked.
	on_demand_tls {
		ask http://127.0.0.1:3000/previews/allow
	}
}

devpipe.com, www.devpipe.com {
	root * /var/www/devpipe
	encode zstd gzip

	# Who asked for what, and when.
	#
	# There was no request log at all, which is how a terminal session that
	# nobody remembers creating became unanswerable: the daemon refuses to
	# attach to a session it does not have, so it had to have come from a real
	# POST, and there was nothing left to say whose or when. A box costs money
	# from the moment it exists and a session spawns a process, so "what
	# actually asked for this" is not a question to be unable to answer.
	#
	# To journald rather than a file. The packaged unit is hardened and cannot
	# write under /var/log — pointing it at a file there does not degrade to
	# console logging, it refuses to start, which takes the whole site down
	# with it. journald already rotates and caps, and `journalctl -u caddy` is
	# where anyone would look first anyway. Bodies are never recorded: only the
	# line, the status, and the address.
	log {
		format json
	}

	# The daemon binary a new box downloads on first boot.
	handle /dist/* {
		file_server
		header Cache-Control "public, max-age=300"
	}

	# The one-liner that installs the Devpipe CLI. Served from disk beside the binaries
	# it fetches rather than through the app, so `curl … | sh` does not depend
	# on the API tier being up — the first thing a new user runs should not
	# fail for a reason that has nothing to do with them.
	handle /install.sh {
		file_server
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=300"
	}

	# Everything else is the app: the API, the web client, and the lander,
	# which the web tier serves at the root itself.
	handle {
		reverse_proxy 127.0.0.1:3001
	}

	# Both processes behind this send the same set themselves, from
	# src/security/headers.ts — keep the two in step. They are repeated here so
	# that anything Caddy serves directly, /dist included, is covered too.
	header {
		# The web client connects a websocket straight to the user's own box,
		# so connect-src has to allow the wildcard boxes live under. It also
		# instantiates the terminal emulator from WebAssembly, which needs
		# wasm-unsafe-eval — narrower than the unsafe-eval it would otherwise
		# require.
		#
		# script-src has no 'unsafe-inline'. It used to, for one <script> block
		# on the lander; that block is /lander.js now precisely so this can say
		# no. The session is an HttpOnly cookie now, so an injected script can
		# no longer read it — but it can still act as the user for as long as
		# the page is open, which this directive is what stands in the way of.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' wss://*.devpipe.com https://*.devpipe.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; frame-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
}

# No block for *.devpipe.com on purpose. A wildcard certificate can only be
# issued over DNS-01, which needs a Caddy built with the DigitalOcean DNS
# plugin; naming the wildcard here without it puts Caddy into a retry loop
# against Let's Encrypt forever.
#
# The wildcard A record still points here, which is what we want: each user's
# box will get its own subdomain and its own HTTP-01 certificate when it is
# provisioned, and that record is the fallback until it is.

# Previews: `p-<random>.devpipe.com`, one hostname per port somebody is looking
# at on a box.
#
# A catch-all rather than a named site, because the names are created at
# runtime and there is no list to write down here. On-demand TLS is what makes
# that safe to say — each name gets its own HTTP-01 certificate the first time
# it is asked for, and only if the API recognises it, so this block cannot be
# used to make this server fetch certificates for hostnames that are not ours.
#
# Straight to the API rather than through the web tier. Two reasons: a preview
# is not the app and must not inherit its Content-Security-Policy, which
# forbids the inline scripts most dev servers serve; and the web tier proxies
# with `fetch`, which cannot carry a websocket — so live reload would be the
# one thing that silently did not work.
#
# The named blocks above win for the hostnames they name, so this only ever
# sees what nothing else claimed.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000 {
		# A dev server's socket is as long-lived as a terminal's, and a first
		# request can sit for a minute while the application compiles.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	log {
		format json
	}
}
